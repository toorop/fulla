---
// Home page: sells Fulla to photographers with little AI culture. Design B ("Selection"): the
// hero is a Photoshop-like workspace where the selection, the prompt, Generate and the result
// play once, then the before/after slider is the visitor's.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { EXCHANGE } from '../lib/download.mjs';
import Compare from '../components/Compare.astro';
import heroBefore from '../assets/examples/a1-avant.jpg';
import heroAfter from '../assets/examples/a1-apres.jpg';
import extendBefore from '../assets/examples/a2-avant.jpg';
import extendAfter from '../assets/examples/a2-apres.jpg';
import mugBefore from '../assets/examples/a3-avant.jpg';
import mugAfter from '../assets/examples/a3-apres.jpg';
import mugRef from '../assets/examples/a3-ref.jpg';
import trainBefore from '../assets/examples/a4-avant.jpg';
import trainWithRef from '../assets/examples/a4-avec-ref.jpg';
import trainWithoutRef from '../assets/examples/a4-sans-ref.jpg';
import trainRef from '../assets/examples/a4-ref.jpg';
import faceBefore from '../assets/examples/a5-avant.jpg';
import faceAfter from '../assets/examples/a5-apres.jpg';
import faceRef from '../assets/examples/a5-ref.jpg';

const title = 'Fulla: free generative fill plugin for Photoshop';
const description =
	'Free generative fill plugin for Photoshop: select, describe, Generate. Pay the AI service per image, from about 5 cents. No subscription, no credits.';

// Where the boat is in the hero photo (A1), in percent: the marching ants go there.
// Measured from the before/after pair (2026-11-12): the area that changed.
const selection = { left: 54.2, top: 42.8, width: 17.6, height: 20.3 };
// The selection of the mug example (A3), measured the same way (2026-11-16): the steps show it.
const mugSelection = { left: 2.1, top: 18.7, width: 58.4, height: 76.9 };
const box = (r: typeof selection) => `left:${r.left}%;top:${r.top}%;width:${r.width}%;height:${r.height}%`;

// Draft figures (10 November 2026): to check again before release, see the pricing note.
const prices = {
	checked: '10 November 2026',
	photoshop: { fill2k: '20 credits', fill2kMoney: 'about $0.10 at the smallest monthly add-on', fill4k: '30 credits, about $0.15' },
	fulla: { fill2k: 'about $0.05', fill4k: 'about $0.12', cheaper: 'About $0.04 at 2K with MiniMax H3 Image, good for a simple removal' },
};

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'Fulla',
		description,
		applicationCategory: 'MultimediaApplication',
		applicationSubCategory: 'Plugin for Photoshop',
		operatingSystem: 'Windows, macOS',
		softwareRequirements: 'Adobe Photoshop 27.11 or later',
		license: 'https://opensource.org/licenses/MIT',
		url: 'https://fulla.dppst.com/',
		downloadUrl: 'https://fulla.dppst.com/docs/install/',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		author: { '@type': 'Person', name: 'Stéphane Depierrepont', url: 'https://dppst.com/' },
	},
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
	<div class="wrap intro">
		<h1>Generative fill in Photoshop.<br /> Pay only for the images you make.</h1>
		<div class="intro-row">
			<p class="lede">
				Fulla is a free plugin for Photoshop. Select an area, say what you want, click Generate: just like Photoshop's own
				generative fill. Connect once in a few clicks, and Fulla picks a recommended model for you. From about 5 cents an
				image, no subscription, no credits.
			</p>
			<div class="actions"><a class="btn btn-solid" data-umami-event="install-cta" data-umami-event-from="hero" href={EXCHANGE}>Get Fulla, free</a><a class="btn btn-line" href="/docs/">Get started</a></div>
		</div>
	</div>

	<div class="board">
		<div class="wrap">
			<div class="stage">
				<div class="doc" id="doc">
					<Compare
						id="hero-compare"
						before={heroBefore}
						after={heroAfter}
						beforeAlt="Before: a small motorboat moored along a pier at low tide, black and white"
						afterAlt="After: the same pier, the boat removed"
						start={100}
						sizes="(min-width: 1280px) 1100px, 100vw"
						priority
					/>
					<div class="ants" id="ants" style={box(selection)} aria-hidden="true">
						<svg preserveAspectRatio="none" viewBox="0 0 100 100"><rect class="w" width="100" height="100"></rect><rect class="k" width="100" height="100"></rect></svg>
					</div>
				</div>
				<div class="readout strip" id="strip">
					<div class="ex-prompt empty" id="prompt">Prompt left empty</div>
					<span class="gen" id="gen" aria-hidden="true">Generate</span>
					<div class="strip-end">
						<div class="status" id="status" aria-hidden="true"></div>
						<dl class="facts">
							<div><dt>Model</dt><dd>Nano Banana 2.1</dd></div>
							<div><dt>Size</dt><dd>2K</dd></div>
							<div><dt>Tries</dt><dd>1</dd></div>
							<div><dt>Cost</dt><dd>$0.06</dd></div>
						</dl>
					</div>
				</div>
				<p class="board-note">Drag across the photo to compare. No retouching after Fulla.</p>
			</div>
		</div>
	</div>

	<section>
		<div class="wrap">
			<h2 class="head">If you know Photoshop's generative&nbsp;fill,<br /> you already know Fulla.</h2>
			<ol class="steps">
				<li>
					<div class="mini" aria-hidden="true">
						<Picture src={mugBefore} alt="" widths={[480, 800]} sizes="(min-width: 900px) 400px, 100vw" formats={['avif', 'webp']} />
						<div class="ants on" style={box(mugSelection)}><svg preserveAspectRatio="none" viewBox="0 0 100 100"><rect class="w" width="100" height="100"></rect><rect class="k" width="100" height="100"></rect></svg></div>
					</div>
					<h3>Select the area to change</h3>
					<p>With any selection tool: lasso, marquee, Select Subject.</p>
				</li>
				<li>
					<div class="mini" aria-hidden="true">
						<Picture src={mugBefore} alt="" widths={[480, 800]} sizes="(min-width: 900px) 400px, 100vw" formats={['avif', 'webp']} />
						<div class="ants on" style={box(mugSelection)}><svg preserveAspectRatio="none" viewBox="0 0 100 100"><rect class="w" width="100" height="100"></rect><rect class="k" width="100" height="100"></rect></svg></div>
						<div class="mini-prompt"><span class="mini-ref"><Picture src={mugRef} alt="" widths={[120]} sizes="48px" formats={['avif', 'webp']} /></span><span>Put the mug from the reference image on the table.</span></div>
					</div>
					<h3>Say what you want</h3>
					<p>In plain words. Add a reference image if you have one.</p>
				</li>
				<li>
					<div class="mini" aria-hidden="true">
						<Picture src={mugAfter} alt="" widths={[480, 800]} sizes="(min-width: 900px) 400px, 100vw" formats={['avif', 'webp']} />
						<div class="mini-layers"><div class="layer on"><span class="th th-mug"></span>Fulla 1</div><div class="layer"><span class="th th-bg"></span>Background</div></div>
					</div>
					<h3>Click Generate</h3>
					<p>The result lands on a new layer, masked by your selection. Your photo itself is never touched.</p>
				</li>
			</ol>
		</div>
	</section>

	<section class="examples band">
		<div class="wrap">
			<h2 class="head">Real results, straight from the panel</h2>
			<p class="sub">Drag across a photo to compare. Under each one, the prompt it was given.</p>

			<figure class="ex wide">
				<figcaption class="ex-head">
					<h3>Extend a photo</h3>
					<p>Canvas enlarged in Photoshop, each empty band filled in turn. <span class="ex-note">Sample photo generated for this demo.</span> <a href="/docs/generative-fill/remove-and-extend/">How to extend</a></p>
				</figcaption>
				<div class="frame">
					<Compare before={extendBefore} after={extendAfter} beforeAlt="Before: a beach at sunset on a canvas made wider and taller, the new bands empty" afterAlt="After: the sky, the dunes and the beach continued into both bands" start={100} sizes="(min-width: 1280px) 1184px, 100vw" />
				</div>
				<div class="readout">
					<div class="ex-prompt empty">Prompt left empty</div>
					<dl class="facts">
						<div><dt>Model</dt><dd>Nano Banana 2.1</dd></div>
						<div><dt>Size</dt><dd>4K</dd></div>
						<div><dt>Tries</dt><dd>1 per band</dd></div>
					</dl>
				</div>
			</figure>

			<figure class="ex wide">
				<figcaption class="ex-head">
					<h3>Put the mug where you want it</h3>
					<p>Your selection sets its place and size. <span class="ex-note">Sample photos generated for this demo.</span> <a href="/docs/generative-fill/tips/#select-generously">Tip: leave room for the shadow</a></p>
				</figcaption>
				<div class="frame">
					<Compare before={mugBefore} after={mugAfter} beforeAlt="Before: a wooden kitchen table in low morning light, a croissant on a plate, empty space on the left" afterAlt="After: the white enamel mug from the reference image standing on the table, its shadow cast by the low light" start={64} sizes="(min-width: 1280px) 1184px, 100vw" />
					<div class="ref"><Picture src={mugRef} alt="Reference image: a white enamel mug with a dark blue rim" widths={[300, 600]} sizes="(min-width: 900px) 260px, 30vw" formats={['avif', 'webp']} /><span>Reference</span></div>
				</div>
				<div class="readout">
					<div class="ex-prompt">Put the mug from the reference image on the table.</div>
					<dl class="facts">
						<div><dt>Model</dt><dd>Nano Banana 2.1</dd></div>
						<div><dt>Size</dt><dd>2K</dd></div>
						<div><dt>Tries</dt><dd>1 with this selection</dd></div>
					</dl>
				</div>
			</figure>

			<figure class="ex square">
				<figcaption class="ex-head">
					<h3>Bring back what was really there</h3>
					<p>With another shot from the same series as the reference, the model redraws the real wheels; without it, it invents plausible machinery. Switch between them on the photo. <a href="/docs/generative-fill/reference-images/">How to use references</a></p>
				</figcaption>
				<div class="frame">
					<Compare before={trainBefore} after={trainWithRef} beforeAlt="Before: a railwayman standing in front of an electric locomotive numbered 5402, decked with flags, in an archive photo" afterAlt="After, with the reference: the man removed, the locomotive's front bogie and wheels as on the real machine" afterLabel="With reference" variants={[{ label: 'Without reference', image: trainWithoutRef, alt: 'After, without the reference: the man removed, the model invented a bulky block of machinery and a larger wheel' }]} reference={{ image: trainRef, alt: 'Reference image: another shot of the same series, the locomotive without the man' }} start={45} sizes="(min-width: 1280px) 720px, 100vw" />
				</div>
				<div class="readout">
					<div class="ex-prompt">Remove the person and use reference image 1 to rebuild what is behind him.</div>
					<dl class="facts">
						<div><dt>Model</dt><dd>Nano Banana 2.1</dd></div>
						<div><dt>Size</dt><dd>2K</dd></div>
						<div><dt>Tries</dt><dd>1 with the reference</dd></div>
					</dl>
				</div>
			</figure>

			<figure class="ex wide">
				<figcaption class="ex-head">
					<h3>Swap a face</h3>
					<p>Freckles and mole from the reference, light from the terrace. <span class="ex-note">Sample photos generated for this demo: no real person.</span> <a href="/docs/generative-fill/reference-images/">How to use references</a></p>
				</figcaption>
				<div class="frame">
					<Compare before={faceBefore} after={faceAfter} beforeAlt="Before: four friends laughing at a café terrace in warm evening light" afterAlt="After: the woman second from the left has the face of the reference portrait, freckles and mole included, with her own hair, pose and the terrace light" afterLabel="Result" reference={{ image: faceRef, alt: 'Reference image: a portrait of a woman with freckles, auburn hair tied back, in grey window light' }} start={58} sizes="(min-width: 1280px) 1184px, 100vw" />
				</div>
				<div class="readout">
					<div class="ex-prompt">Replace the face of the woman sitting at the table with the face of the woman in the reference image. Keep her hair, her pose, the angle of her head and the light of the terrace. Do not paste the reference image: only her face should change.</div>
					<dl class="facts">
						<div><dt>Model</dt><dd>Nano Banana 2.1</dd></div>
						<div><dt>Size</dt><dd>2K</dd></div>
						<div><dt>Tries</dt><dd>1</dd></div>
					</dl>
				</div>
			</figure>
		</div>
	</section>

	<section>
		<div class="wrap">
			<h2 class="head">Why Fulla</h2>
			<div class="props">
				<div class="prop"><h3>Pay for what you make, nothing else</h3><p>No subscription, no credits lost at the end of the month. Fulla shows the cost in dollars after every image.</p></div>
				<div class="prop"><h3>Sharp enough for print</h3><p>Up to 4K, depending on the size of your selection.</p></div>
				<div class="prop"><h3>Blends into your photo</h3><p>Fulla sends the whole photo for context, then matches the colours of the result to it.</p></div>
				<div class="prop"><h3>Show it what you mean</h3><p>Add reference images: the real pattern, the real face, the real object.</p></div>
				<div class="prop"><h3>Your photos stay yours</h3><p>There is no Fulla server. Your photo goes straight to the AI service you chose.</p></div>
				<div class="prop"><h3>Free, for good</h3><p>MIT licence. The code is public, and anyone can check what it does.</p></div>
			</div>
			<div class="works">
				<h3>Works with the AI service you choose</h3>
				<div class="services">
					<div class="svc"><h4>OpenRouter</h4><p>One account for every model below</p><ul><li>Nano Banana 2.1 <span>recommended</span></li><li>Nano Banana Pro</li><li>Seedream 5.5</li><li>MiniMax H3 Image</li><li>Qwen Image 3, 2.1 Pro</li><li>GPT Image 2.6, 2.5 Sunburst</li></ul></div>
					<div class="svc"><h4>Google</h4><p>With a Gemini API key</p><ul><li>Nano Banana 2.1</li><li>Nano Banana Pro</li><li>Nano Banana 2 Lite</li></ul></div>
					<div class="svc"><h4>OpenAI</h4><p>With an OpenAI API key</p><ul><li>GPT Image 2.5 Sunburst</li><li>GPT Image 2.5 Flare</li><li>GPT Image 2</li></ul></div>
				</div>
				<p class="aside"><a href="/docs/models/">Which model to choose</a> · <a href="/docs/providers/">Which service to connect</a></p>
			</div>
		</div>
	</section>

	<section class="band">
		<div class="wrap">
			<h2 class="head">What a fill really costs</h2>
			<p class="sub">The same family of model on both sides: Nano Banana 2 in Photoshop, the newer 2.1 in Fulla.</p>
			<div class="cost">
				<div class="card">
					<h3>Photoshop generative fill, with Nano Banana 2</h3>
					<dl>
						<div><dt>One fill, 1K to 2K</dt><dd><span class="big">{prices.photoshop.fill2k}</span><br />{prices.photoshop.fill2kMoney}</dd></div>
						<div><dt>One fill, 4K</dt><dd>{prices.photoshop.fill4k}</dd></div>
						<div><dt>Paid up front</dt><dd>A monthly plan; more credits mean a monthly add-on. Credits left at the end of the month are lost.</dd></div>
						<div><dt>How you see the cost</dt><dd>A credit estimate, if tooltips are on</dd></div>
					</dl>
				</div>
				<div class="card fulla">
					<h3>Fulla, with Nano Banana 2.1</h3>
					<dl>
						<div><dt>One fill, 1K to 2K</dt><dd><span class="big">{prices.fulla.fill2k}</span><br />billed per image by the AI service you connect</dd></div>
						<div><dt>One fill, 4K</dt><dd>{prices.fulla.fill4k}</dd></div>
						<div><dt>With a cheaper model</dt><dd>{prices.fulla.cheaper}</dd></div>
						<div><dt>Paid up front</dt><dd>Nothing. A few dollars of credit, used image by image.</dd></div>
						<div><dt>How you see the cost</dt><dd>In dollars, after every image</dd></div>
					</dl>
				</div>
			</div>
			<p class="note">Prices checked on {prices.checked}, MiniMax on 14 November. <a href="/photoshop-generative-credits/">How we worked them out</a>. Other models work too, such as GPT Image.</p>
			<div class="after-cta"><a class="btn btn-solid" data-umami-event="install-cta" data-umami-event-from="prices" href={EXCHANGE}>Get Fulla, free</a></div>
		</div>
	</section>

	<section class="closing">
		<div class="wrap">
			<h2>Try it on your next photo.</h2>
			<div class="actions"><a class="btn btn-solid big" data-umami-event="install-cta" data-umami-event-from="closing" href={EXCHANGE}>Get Fulla, free</a><a class="btn btn-line big" href="/docs/">Read the guide</a></div>
			<p class="needs">
				You need Photoshop 27.11 or later and an account with an AI service. OpenRouter takes a few clicks from the panel; $5
				of credit is about 100 images. <a href="https://github.com/toorop/fulla">Source code on GitHub</a>.
			</p>
		</div>
	</section>
</Base>

<style>
	/* The intro is kept short (title on two lines, then the text and the buttons in one row) so the
	   hero photo and its strip can be seen whole when the page opens. */
	.intro { padding-block: clamp(24px, 4vw, 48px) clamp(20px, 2.5vw, 32px); }
	h1 { font-size: clamp(2.4rem, 4.6vw, 4rem); line-height: 1; font-weight: 800; letter-spacing: -0.035em; }
	.intro-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 48px; margin-top: 20px; }
	.lede { margin: 0; flex: 1 1 30em; max-width: 52em; }
	.actions { display: flex; gap: 12px; flex-wrap: wrap; }

	/* The workspace: a pasteboard with the document and, right under it, the Fulla panel laid out
	   as a strip, like the readout of the examples. Photo and strip fit the window together. */
	.board { background: var(--f-board); border-block: 1px solid #111; padding: clamp(16px, 2vw, 28px) 0 clamp(24px, 4vw, 48px); }
	/* The photo gets the height left in the window once the header, the intro and the strip are
	   counted (header 64, intro text and paddings, board top 28, strip 70 to 125, margin 16 = the 340px plus
	   the two title lines and the intro paddings), never wider than 1100px nor narrower than 600px. */
	.stage { container-type: inline-size; width: min(100%, 1100px, max(600px, calc((100svh - 340px - 2 * clamp(2.4rem, 4.6vw, 4rem) - clamp(24px, 4vw, 48px) - clamp(20px, 2.5vw, 32px)) * 1.5))); margin: 0 auto; }
	.doc { position: relative; box-shadow: 0 0 0 1px #000, 0 24px 60px rgba(0, 0, 0, 0.55); }
	.ants { position: absolute; pointer-events: none; opacity: 0; transition: opacity 0.3s; }
	.ants.on { opacity: 1; }
	.ants svg { width: 100%; height: 100%; overflow: visible; display: block; }
	.ants rect { fill: none; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
	.ants .w { stroke: #fff; }
	.ants .k { stroke: #000; stroke-dasharray: 5 5; animation: march 0.6s linear infinite; }
	@keyframes march { to { stroke-dashoffset: -10; } }
	.doc:not(.ready) :global(.c-handle), .doc:not(.ready) :global(.c-grip), .doc:not(.ready) :global(input) { visibility: hidden; }

	.gen { flex: none; background: var(--f-ink); color: #1c1c1c; border-radius: 999px; padding: 9px 18px; font-size: 14px; font-weight: 600; transition: transform 0.1s; }
	.gen.press { transform: scale(0.95); }
	/* The end of the strip: the progress while it generates, then the facts, in the same place. */
	.strip-end { flex: none; display: grid; }
	.strip-end > * { grid-area: 1 / 1; align-self: center; }
	.status { font-size: 14px; color: var(--f-ink-2); }
	.status :global(.bar) { height: 3px; background: var(--f-line); border-radius: 2px; overflow: hidden; margin-top: 6px; }
	.status :global(.bar i) { display: block; height: 100%; width: 0; background: var(--f-blue); }
	.strip.playing .facts { visibility: hidden; }
	/* A narrow photo: the facts go under the prompt, which keeps one line. */
	@container (max-width: 899px) {
		.readout.strip { display: grid; grid-template-columns: 1fr auto; align-items: center; }
		.strip-end { grid-column: 1 / -1; }
	}
	.board-note { text-align: center; font-size: 13px; color: var(--f-muted); margin: 14px 0 0; }

	/* Layers, in the third step. */
	.layer { display: flex; align-items: center; gap: 8px; padding: 6px 4px; border-radius: 4px; }
	.layer.on { background: #363636; color: var(--f-ink); }
	.th { width: 28px; height: 22px; border: 1px solid #111; flex: none; }
	.th-bg { background: linear-gradient(#bbb 45%, #777 45%); }
	/* The mug's layer mask: white where the selection was (the left part of the frame), black elsewhere. */
	.th-mug { background: #000; position: relative; }
	.th-mug::after { content: ''; position: absolute; left: 2%; top: 19%; width: 58%; height: 77%; background: #fff; }

	section { padding: clamp(64px, 9vw, 120px) 0; }
	section + section { border-top: 1px solid var(--f-line); }
	/* Every other section sits on the pasteboard grey, as the hero does, down to the end of the page. */
	section.band { background: var(--f-board); border-block: 1px solid #111; }
	section.band + section { border-top: 0; }
	h2 { font-size: clamp(2rem, 3.8vw, 3.2rem); line-height: 1.04; font-weight: 800; letter-spacing: -0.03em; max-width: 32ch; text-wrap: balance; }
	.head { margin-bottom: clamp(36px, 5vw, 60px); }
	.sub { margin: calc(-1 * clamp(20px, 3vw, 40px)) 0 clamp(36px, 5vw, 56px); max-width: 40em; }

	/* Steps, drawn over the mug example in three states. */
	.steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 36px); list-style: none; padding: 0; margin: 0; counter-reset: s; }
	.steps li { counter-increment: s; }
	.mini { position: relative; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; margin-bottom: 20px; box-shadow: 0 0 0 1px #101010; background: var(--f-board); }
	.mini :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
	/* Top right: the bottom of the photo holds the mug's shadow and the croissant. */
	.mini-prompt { position: absolute; top: 8px; right: 8px; left: 46%; display: flex; align-items: center; gap: 8px; background: rgba(40, 40, 40, 0.94); border: 1px solid var(--f-line); border-radius: 8px; padding: 7px 9px; font-size: 12px; line-height: 1.35; color: var(--f-ink); }
	.mini-ref { flex: none; width: 34px; height: 24px; border-radius: 3px; overflow: hidden; box-shadow: 0 0 0 1px #111; }
	.mini-ref :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
	.mini-layers { position: absolute; top: 8px; right: 8px; width: 48%; background: rgba(40, 40, 40, 0.94); border: 1px solid var(--f-line); border-radius: 8px; padding: 6px; font-size: 12px; }
	.mini-layers .layer { padding: 4px; }
	.steps h3 { font-size: 20px; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 6px; }
	.steps h3::before { content: counter(s) '. '; color: var(--f-muted); }
	.steps p { margin: 0; }

	/* Examples: on the pasteboard, like the hero, one under the other, all in view without a click.
	   Each one reads top to bottom: what it shows, the photo, then the prompt it was given and the
	   facts, as the panel showed them. A rule closes each example. */
	.ex { margin: 0; }
	.ex + .ex { margin-top: clamp(36px, 4vw, 56px); padding-top: clamp(24px, 2.5vw, 36px); border-top: 1px solid #2c2c2c; }
	.ex-head { margin-bottom: 16px; }
	.ex-head h3 { font-size: clamp(24px, 2.6vw, 32px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; margin-bottom: 8px; }
	.ex-head p { margin: 0; }
	.ex-note { color: var(--f-muted); }
	.frame { border-radius: 6px; overflow: hidden; aspect-ratio: 3 / 2; background: var(--f-board); position: relative; box-shadow: 0 0 0 1px #000, 0 18px 48px rgba(0, 0, 0, 0.5); }
	.wide .frame { aspect-ratio: 16 / 9; }
	/* The square one is as tall as a wide one, not as wide (it would not fit the screen), and centred. */
	.square .frame, .square .readout { width: min(100%, 666px); margin-inline: auto; }
	.square .frame { aspect-ratio: 1; }
	.frame :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
	.frame :global(.compare.is-live) { height: 100%; }
	/* A reference image, shown small in a corner of its example. */
	.ref { position: absolute; top: 12px; right: 12px; width: 22%; pointer-events: none; border-radius: 6px; overflow: hidden; box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.85), 0 6px 18px rgba(0, 0, 0, 0.5); }
	.frame .ref :global(img) { height: auto; aspect-ratio: 3 / 2; }
	.ref span { position: absolute; left: 6px; bottom: 6px; padding: 2px 6px; border-radius: 4px; font-size: 11px; color: #fff; background: rgba(0, 0, 0, 0.6); }

	/* The panel's readout, right under the photo: the same field and greys as the Fulla panel in the hero. */
	.readout { margin-top: 12px; display: flex; align-items: center; gap: 12px 32px; background: var(--f-panel); border: 1px solid #0e0e0e; border-radius: 10px; padding: 12px; }
	.ex-prompt { flex: 1; background: var(--f-field); border: 1px solid var(--f-line); border-radius: 8px; padding: 10px 12px; color: var(--f-ink); font-size: 15px; line-height: 1.45; }
	.ex-prompt.empty { color: var(--f-muted); }
	.facts { flex: none; margin: 0; padding-right: 8px; display: flex; gap: 12px 28px; }
	.facts dt { font-size: 12px; color: var(--f-muted); }
	.facts dd { margin: 2px 0 0; font-size: 15px; color: var(--f-ink); font-variant-numeric: tabular-nums lining-nums; white-space: nowrap; }
	.square .readout { flex-direction: column; align-items: stretch; }
	.square .facts { padding: 0 4px; }

	/* Why: a properties list. */
	.props { border-top: 1px solid var(--f-line); }
	.prop { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 24px; padding: 26px 0; border-bottom: 1px solid var(--f-line); }
	.prop h3 { font-size: clamp(20px, 2vw, 26px); font-weight: 600; letter-spacing: -0.015em; line-height: 1.2; }
	.prop p { margin: 0; max-width: 36em; }
	.aside { margin-top: 32px; color: var(--f-muted); }

	/* The services and their models, under the properties. */
	.works { margin-top: clamp(48px, 6vw, 72px); }
	.works h3 { font-size: clamp(20px, 2vw, 26px); font-weight: 600; letter-spacing: -0.015em; margin-bottom: 24px; }
	.services { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
	.svc { background: #262626; border: 1px solid var(--f-line); border-radius: 14px; padding: clamp(20px, 2.5vw, 28px); }
	.svc h4 { font-size: 18px; font-weight: 600; color: var(--f-ink); }
	.svc p { margin: 4px 0 16px; font-size: 14px; color: var(--f-muted); }
	.svc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; color: var(--f-ink-2); }
	.svc li span { margin-left: 6px; font-size: 13px; color: var(--f-muted); }
	.works .aside { margin-top: 24px; }
	@media (max-width: 799px) { .services { grid-template-columns: 1fr; } }

	/* Prices. */
	.cost { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
	.card { background: #262626; border: 1px solid var(--f-line); border-radius: 14px; padding: clamp(20px, 3vw, 32px); }
	.card.fulla { background: #2c2c2c; border-color: #4a4a4a; }
	.card h3 { font-size: 15px; font-weight: 600; color: var(--f-muted); margin-bottom: 18px; }
	.cost dl { margin: 0; display: grid; gap: 18px; }
	.cost dt { font-size: 14px; color: var(--f-muted); }
	.cost dd { margin: 2px 0 0; color: var(--f-ink); }
	.big { font-size: clamp(28px, 3vw, 40px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
	.note { margin-top: 18px; font-size: 14px; color: var(--f-muted); }
	.after-cta { margin-top: 36px; }

	.closing { text-align: center; }
	.closing h2 { margin: 0 auto; max-width: 16ch; font-size: clamp(2.4rem, 5.4vw, 4.6rem); }
	.closing .actions { justify-content: center; margin-top: 32px; }
	.closing .big { padding: 18px 30px; font-size: 17px; border-radius: 999px; }
	.needs { margin: 40px auto 0; max-width: 36em; color: var(--f-muted); font-size: 15px; }

	@media (max-width: 900px) {
		.intro, .steps, .cost, .prop { grid-template-columns: 1fr; }
		.readout { flex-direction: column; align-items: stretch; }
		.facts { padding: 0 4px; }
	}
	@media (max-width: 560px) { .facts { flex-wrap: wrap; gap: 12px 32px; } }
	@media (prefers-reduced-motion: reduce) { .ants .k { animation: none; } }
</style>

<script>
	// One orchestrated moment: select, type, generate, reveal. Then the slider is the visitor's.
	const doc = document.getElementById('doc')!;
	const ants = document.getElementById('ants')!;
	const prompt = document.getElementById('prompt')!;
	const gen = document.getElementById('gen')!;
	const status = document.getElementById('status')!;
	const strip = document.getElementById('strip')!;
	const cmp = document.getElementById('hero-compare')!;
	const range = cmp.querySelector('input')!;
	// Through the input event, so the slider also shows or hides its labels.
	const setPos = (v: number) => {
		range.value = String(v);
		cmp.style.setProperty('--pos', v + '%');
		range.dispatchEvent(new Event('input'));
	};
	const finish = () => {
		ants.classList.remove('on');
		prompt.textContent = 'Prompt left empty';
		status.textContent = '';
		strip.classList.remove('playing');
		doc.classList.add('ready');
		setPos(50);
		setTimeout(() => cmp.classList.remove('is-animating'), 1000);
	};
	const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
	if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
		finish();
	} else {
		cmp.classList.add('is-animating');
		strip.classList.add('playing');
		prompt.textContent = 'Describe what to add, or leave empty to remove';
		(async () => {
			await wait(500);
			ants.classList.add('on');
			await wait(1100);
			gen.classList.add('press');
			await wait(140);
			gen.classList.remove('press');
			status.innerHTML = 'Generating…<div class="bar"><i></i></div>';
			status.querySelector('i')!.animate([{ width: '0%' }, { width: '100%' }], { duration: 1500, easing: 'ease-in-out', fill: 'forwards' });
			await wait(1600);
			setPos(0);
			await wait(900);
			finish();
		})();
	}
</script>
