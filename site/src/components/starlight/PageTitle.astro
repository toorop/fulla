---
// The page title, with "Copy page as Markdown" beside it.
import { markdownUrl } from '../../lib/markdown';

const { entry, id } = Astro.locals.starlightRoute;
---

<div class="title-row">
	<h1 id="_top">{entry.data.title}</h1>
	<button class="f-copy" type="button" data-md={markdownUrl(id)}>
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h8"></path></svg>
		<span>Copy page as Markdown</span>
	</button>
</div>

<style>
	.title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-top: 1rem; }
	h1 { font-size: var(--sl-text-h1); line-height: var(--sl-line-height-headings); color: var(--sl-color-white); margin: 0; }
	.f-copy { margin-top: 0.4rem; }
	@media (max-width: 40rem) { .title-row { flex-direction: column; gap: 0.75rem; } .f-copy { margin-top: 0; } }
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>('.f-copy').forEach((b) => {
		b.addEventListener('click', async () => {
			const label = b.querySelector('span')!;
			try {
				const md = await (await fetch(b.dataset.md!)).text();
				await navigator.clipboard.writeText(md);
				label.textContent = 'Copied';
			} catch {
				label.textContent = 'Copy failed';
			}
			setTimeout(() => (label.textContent = 'Copy page as Markdown'), 2000);
		});
	});
</script>
