---
// Before/after slider. Two real <img>, readable without JavaScript (shown one under the other);
// with JavaScript they are stacked and a range input, usable from the keyboard, moves the split.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	before: ImageMetadata;
	after: ImageMetadata;
	beforeAlt: string;
	afterAlt: string;
	/** Where the split starts, in percent of the width. */
	start?: number;
	/** `sizes` attribute for the responsive images. */
	sizes?: string;
	class?: string;
	id?: string;
}
const { before, after, beforeAlt, afterAlt, start = 50, sizes = '(min-width: 1100px) 1000px, 100vw', class: cls, id } = Astro.props;
const widths = [640, 1000, 1400, 1800].filter((w) => w <= after.width);
---

<div class:list={['compare', cls]} data-compare style={`--pos: ${start}%`} id={id}>
	<figure class="c-after"><Picture src={after} alt={afterAlt} widths={widths} sizes={sizes} formats={['avif', 'webp']} /><figcaption>After</figcaption></figure>
	<figure class="c-before"><Picture src={before} alt={beforeAlt} widths={widths} sizes={sizes} formats={['avif', 'webp']} /><figcaption>Before</figcaption></figure>
	<span class="c-handle" aria-hidden="true"></span>
	<input type="range" min="0" max="100" value={start} aria-label="Compare before and after" />
</div>

<style>
	/* Without JavaScript: one image under the other, each labelled. */
	.compare { position: relative; display: grid; gap: 8px; }
	figure { margin: 0; position: relative; }
	figure :global(img) { display: block; width: 100%; height: auto; }
	figcaption { position: absolute; top: 10px; left: 10px; padding: 3px 8px; border-radius: 4px; font-size: 12px; color: #fff; background: rgba(0, 0, 0, 0.55); }
	.c-before { order: -1; }
	input, .c-handle { display: none; }

	/* With JavaScript: stacked, the before image clipped at the split. */
	.compare.is-live { display: block; overflow: hidden; touch-action: pan-y; }
	.is-live figure { position: absolute; inset: 0; }
	.is-live .c-after { position: relative; }
	.is-live figure :global(img) { height: 100%; object-fit: cover; user-select: none; -webkit-user-drag: none; }
	.is-live .c-before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
	.is-live figcaption { display: none; }
	.is-live input { display: block; position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; appearance: none; -webkit-appearance: none; }
	.is-live .c-handle { display: block; position: absolute; top: 0; bottom: 0; left: var(--pos); width: 0; pointer-events: none; }
	.c-handle::before { content: ''; position: absolute; top: 0; bottom: 0; left: -1px; width: 2px; background: #fff; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.35); }
	.c-handle::after { content: ''; position: absolute; top: 50%; left: -14px; width: 28px; height: 28px; margin-top: -14px; border-radius: 6px; background: #fff; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5); }
	.compare:has(input:focus-visible) .c-handle::after { outline: 2px solid var(--f-blue); outline-offset: 3px; }
	@media (prefers-reduced-motion: no-preference) {
		.compare.is-animating .c-before { transition: clip-path 0.9s cubic-bezier(0.6, 0, 0.2, 1); }
		.compare.is-animating .c-handle { transition: left 0.9s cubic-bezier(0.6, 0, 0.2, 1); }
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-compare]').forEach((el) => {
		const range = el.querySelector('input')!;
		const set = () => el.style.setProperty('--pos', range.value + '%');
		el.classList.add('is-live');
		set();
		range.addEventListener('input', set);
	});
</script>
