---
// One button that switches between dark (the default) and light, instead of Starlight's menu.
import { Icon } from '@astrojs/starlight/components';
---

<f-theme-toggle>
	<button type="button" aria-label="Switch to light theme">
		<Icon name="sun" class="to-light" />
		<Icon name="moon" class="to-dark" />
	</button>
</f-theme-toggle>

<style>
	button { display: inline-flex; padding: 0.5em; margin: -0.5em; border: 0; background: none; color: var(--sl-color-text-accent); cursor: pointer; }
	button:hover { color: var(--sl-color-white); }
	:global([data-theme='dark']) .to-dark, :global([data-theme='light']) .to-light { display: none; }
</style>

<script>
	class FullaThemeToggle extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button')!;
			const label = () => button.setAttribute('aria-label', document.documentElement.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
			label();
			button.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
				document.documentElement.dataset.theme = next;
				try { localStorage.setItem('starlight-theme', next); } catch {}
				label();
			});
		}
	}
	customElements.define('f-theme-toggle', FullaThemeToggle);
</script>
