---
// A result with the selection it was made with, drawn as marching ants (still, not animated).
// `rect` is the selection in percent of the image: left, top, width, height.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	image: ImageMetadata;
	alt: string;
	rect: { left: number; top: number; width: number; height: number };
	sizes?: string;
}
const { image, alt, rect, sizes = '(min-width: 1000px) 720px, 100vw' } = Astro.props;
const widths = [640, 1000, 1400].filter((w) => w <= image.width);
---

<figure class="selection not-content">
	<div class="frame">
		<Picture src={image} alt={alt} widths={widths} sizes={sizes} formats={['avif', 'webp']} />
		<svg class="ants" style={`left:${rect.left}%;top:${rect.top}%;width:${rect.width}%;height:${rect.height}%`} preserveAspectRatio="none" viewBox="0 0 100 100" aria-hidden="true">
			<rect class="w" width="100" height="100"></rect>
			<rect class="k" width="100" height="100"></rect>
		</svg>
	</div>
	<figcaption><slot /></figcaption>
</figure>

<style>
	.selection { margin: 0; }
	.frame { position: relative; }
	.frame :global(img) { display: block; width: 100%; height: auto; border-radius: 4px; }
	.ants { position: absolute; overflow: visible; pointer-events: none; }
	.ants rect { fill: none; stroke-width: 2; vector-effect: non-scaling-stroke; }
	.ants .w { stroke: #fff; }
	.ants .k { stroke: #000; stroke-dasharray: 6 6; }
	figcaption { margin-top: 8px; font-size: 0.875rem; line-height: 1.5; color: var(--sl-color-gray-2); }
</style>
