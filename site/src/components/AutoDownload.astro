---
// On the Install page: when reached from a Download button (?download), start the download of the
// .ccx and say so. Not on phones, where a .ccx is no use. Reloading the page doesn't download again.
import { DOWNLOAD_CCX } from '../lib/download.mjs';
---

<div class="f-autodl" hidden>
	<aside class="starlight-aside starlight-aside--tip" aria-live="polite">
		<p><strong>Fulla is downloading.</strong> When it's done, double-click <code>fulla.ccx</code> and follow the steps below. Nothing happened? <a href={DOWNLOAD_CCX}>Download fulla.ccx</a>.</p>
	</aside>
</div>

<script is:inline define:vars={{ url: DOWNLOAD_CCX }}>
	(() => {
		const params = new URLSearchParams(location.search);
		if (!params.has('download')) return;
		history.replaceState(null, '', location.pathname + location.hash);
		if (/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)) return;
		document.querySelector('.f-autodl').hidden = false;
		location.href = url;
	})();
</script>
